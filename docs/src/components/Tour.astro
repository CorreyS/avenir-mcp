---
// The 20-second tour: the README demo replayed on the invented plan. Autoplay only
// when the visitor accepts motion; `prefers-reduced-motion` leaves the poster still.
import { home } from './home-i18n';

const t = home(Astro.locals.starlightRoute.lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure id="tour" class="tour not-content">
  <video
    class="tour-video"
    muted
    loop
    playsinline
    preload="metadata"
    controls
    poster={`${base}/tour.jpg`}
    width="1920"
    height="1080"
    aria-label={t.tour}
  >
    <source src={`${base}/tour.mp4`} type="video/mp4" />
  </video>
  <figcaption>{t.tour}</figcaption>
</figure>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('.tour-video')) {
      video.autoplay = true;
      video.play().catch(() => {});
    }
  }
</script>

<style>
  .tour {
    margin: 1.5rem 0 0;
  }

  .tour-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  .tour figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
